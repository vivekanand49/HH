# Copy to .env and fill in. Never commit .env.

PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# Proxies in front of the app (1 = one load balancer or nginx). If the app is
# reachable directly from the internet, set false, or users can fake their IP
# and get around the rate limits.
TRUST_PROXY=1

# Database. Leave DATABASE_URL empty to use the built-in PGlite database
# (real PostgreSQL in-process, stored in PGLITE_DIR). Set it for a real server:
# DATABASE_URL=postgres://user:pass@localhost:5432/swasthya
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# Secrets. REQUIRED in production; long random strings (openssl rand -hex 32).
JWT_SECRET=
ID_HASH_SECRET=
GATEWAY_SECRET=

# Show the OTP in the API response in development (never in production).
OTP_DEV_ECHO=true

# SMS provider: "console" prints messages instead of sending them.
#   sns    - AWS SNS (uses the server's IAM role; region from AWS_REGION)
#   twilio - Twilio Messaging
SMS_PROVIDER=console
# India: every SMS must match a template registered on the DLT portal (Jio,
# Vodafone Idea, Airtel...). Put your principal entity ID and sender ID here and
# map our template names to DLT template IDs. Languages are separate DLT
# templates: "otp.te" is used for Telugu, falling back to "otp".
# Names: otp, booked, booked_counter, alertAck, dispatched, doctorLeave,
# family_link, sos_hospital, sos_family, appointment_hospital, prescription,
# reminder, staff_added, doctor_login
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATES={}
# e.g. SMS_DLT_TEMPLATES={"otp":"1107170000000000001","otp.te":"1107170000000000002"}
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# The number patients send SOS SMS to, and the missed-call number.
SMS_GATEWAY_NUMBER=+910000000000
MISSED_CALL_NUMBER=+910000000001

# Health assistant. Without a key the assistant uses the offline checker only.
ANTHROPIC_API_KEY=

# ---- Step 3 ----
# Files (report photos, SOS voice messages). Local disk unless S3_BUCKET is set;
# on AWS use an IAM role rather than access keys.
UPLOAD_DIR=./.data/uploads
S3_BUCKET=
AWS_REGION=ap-south-1

# Razorpay (UPI / cards / net banking). Leave empty for demo payments in development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Video calls: a TURN server (e.g. coturn) for phones behind strict mobile networks.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Step 4 ----
# Medicine reminders (Web Push). `npm run setup` fills these in.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Bhashini speech-to-text for SOS voice messages (register at bhashini.gov.in,
# keys are under My Profile). Leave empty to keep voice messages audio-only.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
